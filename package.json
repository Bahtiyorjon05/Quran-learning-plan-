{
  "name": "ahd",
  "version": "0.1.0",
  "private": true,
  "description": "Ahd — the Qur'an memorization and revision companion. Plan your hifz, commit to it, practice it, never lose it.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:status": "tsx scripts/db-status.ts",
    "db:reset": "tsx scripts/db-reset.ts",
    "db:clean": "tsx scripts/db-clean-tests.ts",
    "quran:build": "tsx scripts/build-quran-index.ts",
    "brand:build": "tsx scripts/build-brand-assets.ts",
    "quran:mutashabihat": "tsx scripts/build-mutashabihat.ts",
    "verify:practice": "tsx --require ./scripts/allow-server-only.cjs scripts/verify-practice.ts",
    "verify:practice:live": "tsx --require ./scripts/allow-server-only.cjs scripts/verify-practice-live.ts",
    "observe:theme": "tsx --require ./scripts/allow-server-only.cjs scripts/observe-theme.ts",
    "observe:practice": "tsx --require ./scripts/allow-server-only.cjs scripts/observe-practice.ts",
    "admin:grant": "tsx scripts/grant-admin.ts",
    "verify:admin": "tsx --require ./scripts/allow-server-only.cjs scripts/verify-admin.ts",
    "observe:reader": "tsx --require ./scripts/allow-server-only.cjs scripts/observe-reader.ts",
    "verify:routes": "tsx --require ./scripts/allow-server-only.cjs scripts/verify-routes.ts",
    "observe:pwa": "tsx --require ./scripts/allow-server-only.cjs scripts/observe-pwa.ts",
    "observe:mistakes": "tsx --require ./scripts/allow-server-only.cjs scripts/observe-mistakes.ts",
    "observe:signup": "tsx --require ./scripts/allow-server-only.cjs scripts/observe-signup.ts",
    "observe:language": "tsx scripts/observe-language.ts",
    "observe:recitation": "tsx scripts/observe-recitation.ts",
    "observe:settings": "tsx --require ./scripts/allow-server-only.cjs scripts/observe-settings.ts",
    "observe:offline": "tsx scripts/observe-offline.ts",
    "observe:session": "tsx --require ./scripts/allow-server-only.cjs scripts/observe-session.ts",
    "shoot": "tsx --require ./scripts/allow-server-only.cjs scripts/shoot-app.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@node-rs/argon2": "^2.0.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "drizzle-orm": "^0.44.7",
    "lucide-react": "^0.548.0",
    "motion": "^12.24.6",
    "next": "16.3.2",
    "next-intl": "^4.4.0",
    "nodemailer": "^9.0.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "ws": "^8.21.3",
    "zod": "^4.1.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.1",
    "dotenv": "^17.2.4",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "pg": "^8.16.5",
    "playwright-core": "^1.62.1",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.6.14",
    "sharp": "^0.35.4",
    "tailwindcss": "^4",
    "tsx": "^4.20.7",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
