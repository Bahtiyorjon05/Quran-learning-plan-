    "drizzle-orm": "^0.44.7",
    "lucide-react": "^0.548.0",
    "motion": "^12.24.6",
    "next": "16.3.2",
    "next-intl": "^4.4.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "resend": "^6.2.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.1.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
