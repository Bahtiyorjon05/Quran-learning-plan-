# ═══════════════════════════════════════════════════════════════════════════
#  Ahd — environment
#  Copy to .env.local and fill in. Never commit .env.local.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database: Neon serverless Postgres ─────────────────────────────────────
# Neon console → your project → Connection string → "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxxxx.eu-central-1.aws.neon.tech/ahd?sslmode=require"

# Direct (unpooled) connection — drizzle-kit migrations need this one.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxxx.eu-central-1.aws.neon.tech/ahd?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────────────
# Secret used to sign session tokens and email-verification links.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ── Email ──────────────────────────────────────────────────────────────────
# Three transports, tried in this order:
#   1. SMTP      — set SMTP_HOST and the app uses it
#   2. Resend    — otherwise, set RESEND_API_KEY
#   3. Console   — otherwise, verification codes are printed to the terminal,
#                  which is all development needs
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_SECURE="false"          # "true" for port 465, "false" for 587 with STARTTLS

RESEND_API_KEY=""

EMAIL_FROM="Ahd <salom@ahd.uz>"
EMAIL_REPLY_TO=""

# ── Site ───────────────────────────────────────────────────────────────────
# Absolute origin, used for canonical URLs, OG images and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
