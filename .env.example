# ═══════════════════════════════════════════════════════════════════════════
#  Ahd — environment
#  Copy to .env.local and fill in. Never commit .env.local.
# ═══════════════════════════════════════════════════════════════════════════

# ── Database: Neon serverless Postgres ─────────────────────────────────────
# Neon console → your project → Connection string → "Pooled connection".
DATABASE_URL="postgresql://user:password@ep-xxxxx.eu-central-1.aws.neon.tech/ahd?sslmode=require"

# Direct (unpooled) connection — drizzle-kit migrations need this one.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxxx.eu-central-1.aws.neon.tech/ahd?sslmode=require"

# ── Auth ───────────────────────────────────────────────────────────────────
# Secret used to sign session tokens and email-verification links.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# ── Email: Resend ──────────────────────────────────────────────────────────
# Verification links, password resets, weekly report cards.
RESEND_API_KEY=""
EMAIL_FROM="Ahd <salom@ahd.uz>"

# ── Site ───────────────────────────────────────────────────────────────────
# Absolute origin, used for canonical URLs, OG images and email links.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
